---
import Icon from './Icon.astro';
import { LANGUAGES, localePath } from '../content';
import type { Lang, UiStrings } from '../content/types';

interface Props {
  lang: Lang;
  ui: UiStrings;
  path: string;
  map?: boolean;
}

const { lang, ui, path, map } = Astro.props;

const LOGO_USER = 'nikolay';
const LOGO_HOST = '@ivakhnenko';

const RESUME_PATH = '/resume/';
const LANG_LIST_ID = 'lang-list';

const ACTION = 'btn text-12 whitespace-nowrap';
const LANG_BUTTON =
  'inline-flex items-center gap-[5px] rounded-md border border-divider px-[9px] py-[6px] font-mono text-11 text-text cursor-pointer hover:border-accent hover:text-accent';
const LANG_LIST =
  'absolute right-0 top-[calc(100%+7px)] z-40 min-w-full overflow-hidden rounded-md bg-bg shadow-md';
const LANG_ITEM =
  'block px-[13px] py-[7px] font-mono text-11 text-text hover:bg-text/7 hover:text-text hover:no-underline aria-[current=page]:text-accent';

const onResume = path === RESUME_PATH;
const current = LANGUAGES.find((entry) => entry.lang === lang)!;
---

<header
  class="sticky top-0 z-30 flex flex-wrap items-center gap-[clamp(8px,1.4vw,18px)] px-[clamp(12px,3vw,32px)] py-[11px] bg-page/86 shadow-[inset_0_-1px_0_color-mix(in_srgb,var(--color-text)_9%,transparent)] backdrop-blur-[10px] [-webkit-backdrop-filter:blur(10px)] print:hidden"
>
  <a
    class="mr-auto font-mono text-[clamp(11px,1.5vw,13px)] tracking-[.02em] whitespace-nowrap hover:text-accent hover:no-underline"
    href={localePath(lang, '/')}
  >
    {LOGO_USER}<span class="text-text/55">{LOGO_HOST}</span>
  </a>
  {
    map && (
      <button type="button" class={`${ACTION} btn-secondary`} data-to-map hidden>
        <Icon name="arrow-left" size={15} />
        {ui.toMap}
      </button>
    )
  }
  <nav class="relative" aria-label={ui.language} data-lang>
    <button type="button" class={LANG_BUTTON} aria-expanded="false" aria-controls={LANG_LIST_ID} data-lang-button>
      {current.label}
      <Icon name="caret-down" size={11} />
    </button>
    <ul class={LANG_LIST} id={LANG_LIST_ID} data-lang-list hidden>
      {
        LANGUAGES.map((entry) => (
          <li>
            <a
              class={LANG_ITEM}
              href={localePath(entry.lang, path)}
              hreflang={entry.lang}
              data-keep-hash
              aria-current={entry.lang === lang ? 'page' : undefined}
            >
              {entry.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  {
    onResume ? (
      <a class={`${ACTION} btn-primary`} href={localePath(lang, '/')}>
        <Icon name="arrow-left" size={15} />
        {ui.toMap}
      </a>
    ) : (
      <a class={`${ACTION} btn-primary`} href={localePath(lang, RESUME_PATH)}>
        <Icon name="read-cv-logo" size={15} />
        {ui.plainResume}
      </a>
    )
  }
</header>

<script>
  import { initLangMenu } from '../scripts/lang';

  initLangMenu(document.querySelector<HTMLElement>('[data-lang]')!);
</script>
