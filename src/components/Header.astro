---
import Icon from './Icon.astro';
import { localePath } from '../content';
import type { Lang, UiStrings } from '../content/types';

interface Props {
  lang: Lang;
  ui: UiStrings;
  path: string;
  map?: boolean;
}

const { lang, ui, path, map } = Astro.props;

const LOGO_USER = 'nikolay';
const LOGO_HOST = '@ivakhnenko';

const RESUME_PATH = '/resume/';

const ACTION = 'btn text-12 whitespace-nowrap';
const SEG_LINK =
  'px-[9px] py-[6px] font-mono text-11 text-text hover:bg-text/7 hover:text-text hover:no-underline aria-[current=page]:text-accent aria-[current=page]:shadow-[inset_0_0_0_1px_var(--color-accent)] aria-[current=page]:hover:bg-transparent';

const onResume = path === RESUME_PATH;
---

<header
  class="sticky top-0 z-30 flex flex-wrap items-center gap-[clamp(8px,1.4vw,18px)] px-[clamp(12px,3vw,32px)] py-[11px] bg-page/86 shadow-[inset_0_-1px_0_color-mix(in_srgb,var(--color-text)_9%,transparent)] backdrop-blur-[10px] print:hidden"
>
  <a
    class="mr-auto font-mono text-[clamp(11px,1.5vw,13px)] tracking-[.02em] whitespace-nowrap hover:text-accent hover:no-underline"
    href={localePath(lang, '/')}
  >
    {LOGO_USER}<span class="text-text/55">{LOGO_HOST}</span>
  </a>
  {
    map && (
      <button type="button" class={`${ACTION} btn-secondary`} data-to-map hidden>
        <Icon name="arrow-left" size={15} />
        {ui.toMap}
      </button>
    )
  }
  <nav class="inline-flex overflow-hidden rounded-md border border-divider" aria-label={ui.language}>
    <a class={SEG_LINK} href={localePath('ru', path)} hreflang="ru" data-keep-hash aria-current={lang === 'ru' ? 'page' : undefined}>RU</a>
    <a
      class={`${SEG_LINK} border-l border-divider`}
      href={localePath('en', path)}
      hreflang="en"
      data-keep-hash
      aria-current={lang === 'en' ? 'page' : undefined}
    >EN</a>
  </nav>
  {
    onResume ? (
      <a class={`${ACTION} btn-primary`} href={localePath(lang, '/')}>
        <Icon name="arrow-left" size={15} />
        {ui.toMap}
      </a>
    ) : (
      <a class={`${ACTION} btn-primary`} href={localePath(lang, RESUME_PATH)}>
        <Icon name="read-cv-logo" size={15} />
        {ui.plainResume}
      </a>
    )
  }
</header>
