---
import type { SectionKey } from '../content/types';
import '../styles/panel.css';

interface Props {
  section: SectionKey;
  kicker: string;
  close: string;
  closeLabel: string;
}

const { section, kicker, close, closeLabel } = Astro.props;

const kickerId = `${section}-kicker`;
---

<dialog class="panel" data-panel={section} aria-labelledby={kickerId}>
  <article class="panel-box">
    <div class="mb-[clamp(14px,2vw,22px)] flex items-center gap-[14px]">
      <p class="mb-0 text-10 tracking-[.12em] uppercase text-accent" id={kickerId}>{kicker}</p>
      <button
        type="button"
        class="ml-auto rounded-[7px] border border-text/18 px-[10px] py-[5px] font-mono text-11 text-text/60 cursor-pointer hover:border-accent hover:text-accent"
        aria-label={closeLabel}
        data-close>{close}</button
      >
    </div>
    <slot />
  </article>
</dialog>
