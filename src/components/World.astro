---
import Icon from './Icon.astro';
import { GLOW_DELAY_STEP_SECONDS, PADS } from '../data/pads';
import type { Person, UiStrings } from '../content/types';
import '../styles/panel.css';
import '../styles/world.css';

interface Props {
  ui: UiStrings;
  person: Person;
}

const { ui, person } = Astro.props;

const DPAD = ['up', 'left', 'down', 'right'] as const;
const DPAD_GLYPHS = { up: '↑', left: '←', down: '↓', right: '→' };
const DPAD_CELL = {
  up: 'col-start-2 row-start-1',
  left: 'col-start-1 row-start-2',
  down: 'col-start-2 row-start-2',
  right: 'col-start-3 row-start-2',
};
---

<main
  class="map flex flex-1 flex-col items-center justify-center gap-[clamp(10px,2vh,18px)] overflow-hidden px-[10px] py-[clamp(10px,2vh,24px)]"
  data-world
>
  <div class="viewport" role="application" aria-label={ui.mapLabel}>
    <div class="world">
      {
        PADS.map((pad, index) => (
          <button
            type="button"
            class:list={['pad', pad.key === 'console' && 'pad-system']}
            style={`--pad-x:${pad.x}px;--pad-y:${pad.y}px;--pad-delay:${index * GLOW_DELAY_STEP_SECONDS}s`}
            data-pad={pad.key}
            data-announce={`${ui.pads[pad.key]}. ${ui.padAnnounce}`}
            aria-label={`${ui.openSection}: ${ui.pads[pad.key]}`}
            hidden={pad.key === 'console'}
          >
            <span class="pad-glow" />
            <Icon name={pad.icon} />
            <span class="pad-label">{ui.pads[pad.key]}</span>
          </button>
        ))
      }
      <div class="guy">
        <p class="guy-hint font-mono" data-hint hidden><span>{ui.enter}</span></p>
        <span class="guy-shadow"></span>
        <span class="guy-body"></span>
        <span class="guy-visor"></span>
      </div>
    </div>
    <div class="pointer-events-none absolute top-[13px] left-[16px] max-w-[62%]">
      <h1 class="mb-0 text-[clamp(17px,4.4vw,22px)]">{person.name}</h1>
      <p class="mt-[2px] mb-0 text-[12.5px] text-text/55">{person.role}</p>
    </div>
  </div>

  <div class="flex w-[var(--viewport-width)] items-center justify-between gap-[14px]">
    <div class="grid grid-cols-[repeat(3,44px)] grid-rows-[repeat(2,44px)] gap-[6px]">
      {
        DPAD.map((direction) => (
          <button type="button" class={`${DPAD_CELL[direction]} dpad-key`} data-move={direction} aria-label={direction}>
            {DPAD_GLYPHS[direction]}
          </button>
        ))
      }
    </div>
    <button type="button" class="dpad-enter" data-open>{ui.open}</button>
  </div>

  <p class="sr-only" aria-live="polite" data-status></p>

  <dialog class="panel" data-not-found>
    <div class="panel-note">
      <p class="mb-0 font-mono text-[clamp(13px,2.6vw,16px)] text-text/62">{ui.notFound.title}</p>
      <button type="button" class="btn btn-secondary" data-close>
        <Icon name="arrow-left" size={16} />
        {ui.notFound.back}
      </button>
    </div>
  </dialog>
</main>
