---
import type { Skills } from '../../content/types';

interface Props {
  skills: Skills;
}

const { skills } = Astro.props;
---

<h2 class="mb-[18px] text-[clamp(22px,3vw,30px)]">{skills.title}</h2>
<table class="data-table">
  <tbody>
    {
      skills.rows.map((row) => (
        <tr>
          <td class="w-[34%] text-13 text-text/60">{row.category}</td>
          <td>{row.items.join(', ')}</td>
        </tr>
      ))
    }
  </tbody>
</table>
<p class="mt-[20px] max-w-[64ch] text-14 leading-[1.7] text-text/60">{skills.note}</p>
