---
import Base from '../layouts/Base.astro';
import World from '../components/World.astro';
import Console from '../components/Console.astro';
import Sections from '../components/Sections.astro';
import { getContent } from '../content';

const content = getContent('ru');
---

<Base lang="ru" map>
  <World ui={content.ui} person={content.person} />
  <Console lang="ru" console={content.console} />
  <Sections lang="ru" content={content} />
</Base>
